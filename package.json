{
	"name": "sveltegram",
	"description": "Reactive Telegram widgets built with svelte",
	"version": "2.2.1",
	"license": "MIT",
	"sideEffects": false,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"lint": "oxlint"
	},
	"devDependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/schibsted-grotesk": "^5.3.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@twinkleplop/bash": "^0.1.8",
		"@twinkleplop/svelte": "^0.1.8",
		"@twinkleplop/theme-ayu": "^0.1.5",
		"dotenv": "^17.4.2",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"publint": "^0.3.22",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"engines": {
		"node": ">=22.17.0"
	},
	"type": "module",
	"author": "Amr <contact@a3k.me> (https://www.a3k.me/)",
	"keywords": [
		"svelte",
		"sveltekit",
		"telegram",
		"post",
		"comments",
		"discussion",
		"login",
		"auth",
		"share",
		"widget",
		"embed"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/amr3k/sveltegram.git"
	},
	"homepage": "https://sveltegram.a3k.me",
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"packageManager": "pnpm@12.21.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
